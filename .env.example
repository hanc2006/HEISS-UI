COMFY_URL=http://127.0.0.1:8188
# When COMFY_URL doesn't answer, HEISS looks on 8188 and 8000 and switches to what it finds.
# 0 keeps it on COMFY_URL, e.g. with a second ComfyUI on this computer it must not take over.
# HEISS_COMFY_SEARCH=0
# 0.0.0.0 lets other devices on the network sign in; 127.0.0.1 keeps it on this computer.
HOST=0.0.0.0
PORT=8787
HEISS_DATA_DIR=./data
COMFY_OUTPUT_DIR=
# Inpainting is on by default. Set to 0 to hide it.
# HEISS_ENABLE_INPAINT=0
# Optional encoder override. Grid previews use bundled FFmpeg, then system ffmpeg.
# HEISS_FFMPEG_PATH=
# Size of the ordinary video preview cache in MB (Hidden previews stay in memory).
# HEISS_VIDEO_PREVIEW_CACHE_MB=512
# Model downloads: a Hugging Face token for gated repos (sent to huggingface.co only), a mirror, a proxy.
# HF_TOKEN=
# HF_ENDPOINT=https://hf-mirror.com
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1
# Other devices (Settings › Connection). Extra names this server answers to,
# comma-separated, e.g. a home DNS name or a tailnet name behind a proxy.
HEISS_ALLOWED_HOSTS=
# The studio password other devices sign in with (8+ characters). When set, it
# replaces the one saved in Settings. Without it, a server that opens no browser
# (HEISS_NO_BROWSER=1, SSH, Linux without a display) makes one up on first
# start and prints it once.
# HEISS_STUDIO_PASSWORD=
# 1 lets signed-in devices look after the computer (installs, updates, folders),
# like "Trust other devices with admin" in Settings › Connection.
# HEISS_ADMIN_FROM_DEVICES=1
# How long a signed-in phone or computer stays signed in, in days (1-30).
HEISS_DEVICE_SESSION_DAYS=7
# Optional HTTPS for other devices: a certificate and key you already have,
# e.g. from `tailscale cert`. Settings › Connection writes these too.
HEISS_TLS_CERT=
HEISS_TLS_KEY=
# The HTTPS port (PORT + 1 unless set).
HEISS_HTTPS_PORT=
# Days the gallery trash keeps what "Delete all" moved there (default 30).
HEISS_TRASH_DAYS=30
